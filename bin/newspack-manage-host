#!/bin/bash
# Wrapper script for managing loopback aliases and /etc/hosts entries.
# Intended to be granted passwordless sudo via a sudoers drop-in,
# so that non-interactive processes (e.g. AI agents) can set up
# networking for isolated environments without a password prompt.
#
# Only allows:
#   - Adding/removing loopback aliases on lo0 (127.0.0.*)
#   - Adding /etc/hosts entries for 127.0.0.* -> *.test / *.local domains
#   - Removing /etc/hosts entries for *.test / *.local domains

set -euo pipefail

# Pin a fixed, root-owned PATH before invoking any external command.
#
# This script is granted passwordless root by a sudoers drop-in, and macOS
# sudoers sets no secure_path, so sudo hands it the CALLER's PATH untouched.
# Without this line, a helper binary planted earlier in that PATH runs as root,
# and any process running as the user — including the non-interactive callers
# this wrapper exists to serve — inherits that.
#
# Every directory here must be writable only by root, which is the property
# doing the work. On Apple Silicon /opt/homebrew/bin is group-writable and owned
# by the login user, so adding it would restore the same hole under a different
# name; the same applies to any brew prefix. /usr/local/bin is left out on the
# same principle even where it happens to be root-owned, because nothing needed
# here lives there and its permissions vary by machine.
#
# The pin must also cover every external command below. An uncovered command
# usually dies under `set -e` with a confusing "command not found" -- but not
# always, and the exception is the dangerous one: a command in a condition is
# exempt from `set -e`, so its 127 becomes an ordinary false. host-add reads
# grep's status explicitly for that reason; see the comment there. Today the
# helpers are ifconfig (/sbin), grep (/usr/bin) and sed (/usr/bin). Adding a
# call to anything outside these directories means reconsidering this line,
# not widening it reflexively.
#
# Two things outside this line carry the same weight. Line 1 is an absolute
# `#!/bin/bash` on purpose: `#!/usr/bin/env bash` would have env search the
# caller's forwarded PATH for an interpreter, as root, before this line runs,
# and no pin here could reach that. And the sudoers grant must name the copy
# bin/setup-networking.sh installs at /usr/local/bin -- granting a path inside
# a developer's checkout would let the login user edit this file rather than
# having to hijack PATH at all. Note what that does and does not buy: the
# installer chowns the file to root:wheel, but whether an entry can be replaced
# is governed by its containing directory, and /usr/local/bin is owned by the
# login user on any machine where Homebrew created it. The checkout path is
# still the worse of the two, and this is not the same as saying the installed
# copy cannot be swapped.
#
# bin/tests/test-newspack-manage-host-path.sh proves the pin holds, and pins
# the shebang behaviourally with its own hijack probe.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

usage() {
    echo "Usage:"
    echo "  $0 alias-add <127.0.0.X>"
    echo "  $0 alias-remove <127.0.0.X>"
    echo "  $0 host-add <127.0.0.X> <domain.test>"
    echo "  $0 host-remove <domain.test>"
    exit 1
}

validate_loopback_ip() {
    if [[ ! "$1" =~ ^127\.0\.0\.[0-9]+$ ]]; then
        echo "Error: invalid loopback IP '$1' (must be 127.0.0.X)" >&2
        exit 1
    fi
}

validate_local_domain() {
    if [[ ! "$1" =~ ^[a-zA-Z0-9._-]+\.(test|local)$ ]]; then
        echo "Error: invalid domain '$1' (must end in .test or .local)" >&2
        exit 1
    fi
}

[[ $# -lt 2 ]] && usage

case "$1" in
    alias-add)
        validate_loopback_ip "$2"
        ifconfig lo0 alias "$2"
        ;;
    alias-remove)
        validate_loopback_ip "$2"
        ifconfig lo0 -alias "$2"
        ;;
    host-add)
        [[ $# -lt 3 ]] && usage
        validate_loopback_ip "$2"
        validate_local_domain "$3"
        # Don't add if already present. grep's status is read explicitly
        # because `if ! grep ...` cannot tell "no match" from "grep did not
        # run": under `set -e` a condition is exempt, so a 127 from a grep
        # outside the pinned PATH would invert to true and append a duplicate
        # on every call. 0 = present, 1 = absent, anything else is a failure
        # to report rather than to interpret.
        grep_status=0
        grep -q "[[:space:]]${3}$" /etc/hosts || grep_status=$?
        case "$grep_status" in
            0) ;;
            1) echo "$2 $3" >> /etc/hosts ;;
            *) echo "Error: could not read /etc/hosts (grep exited $grep_status)." >&2; exit 1 ;;
        esac
        ;;
    host-remove)
        validate_local_domain "$2"
        escaped="${2//./\\.}"
        # BSD sed first, fall back to GNU sed.
        sed -i '' "/[[:space:]]${escaped}$/d" /etc/hosts 2>/dev/null || \
            sed -i "/[[:space:]]${escaped}$/d" /etc/hosts
        ;;
    *)
        usage
        ;;
esac
