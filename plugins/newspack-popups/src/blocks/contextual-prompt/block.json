{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-popups/contextual-prompt",
	"title": "Campaigns: Contextual Prompt",
	"category": "newspack",
	"description": "A story-specific donation ask. Copy is generated from the story and editable; the call to action follows your donation settings.",
	"attributes": {
		"layout": {
			"type": "object",
			"default": {
				"type": "default"
			}
		}
	},
	"example": {
		"attributes": {},
		"innerBlocks": [
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Reporting like this takes time and costs money. If you value it, consider supporting our newsroom."
				}
			},
			{
				"name": "core/buttons",
				"innerBlocks": [
					{
						"name": "core/button",
						"attributes": {
							"text": "Donate"
						}
					}
				]
			}
		],
		"viewportWidth": 800
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"multiple": false,
		"reusable": false,
		"layout": {
			"default": {
				"type": "default"
			},
			"allowJustification": false,
			"allowSwitching": false
		},
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		},
		"dimensions": {
			"minHeight": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"shadow": true,
		"lock": false
	}
}
